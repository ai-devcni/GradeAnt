{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gradeant.local/schemas/gradeant-ir-v1.schema.json",
  "title": "GradeAnt Interface IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document", "components"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "metadata", "layout"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "metadata": {
          "$ref": "#/$defs/stringMap"
        },
        "layout": {
          "$ref": "#/$defs/layout"
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "gap", "columns"],
      "properties": {
        "kind": {
          "enum": ["absolute", "horizontal", "vertical", "grid"]
        },
        "gap": {
          "type": "integer",
          "minimum": 0
        },
        "columns": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foreground", "background", "border_color", "border_width", "border_radius"],
      "properties": {
        "foreground": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "border_color": {
          "type": "string"
        },
        "border_width": {
          "type": "integer",
          "minimum": 0
        },
        "border_radius": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "bounds",
        "text",
        "style",
        "layout",
        "constraints",
        "asset",
        "confidence",
        "properties",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "text": {
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asset": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "properties": {
          "$ref": "#/$defs/stringMap"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      }
    }
  }
}
